{
  "name": "shiguang-toolbox",
  "version": "1.1.0",
  "description": "一个支持全局热键、拖放与分类管理的 Windows 快速启动工具箱",
  "author": "Shiguang Toolbox contributors",
  "license": "MIT",
  "keywords": ["windows", "launcher", "toolbox", "electron", "productivity"],
  "engines": { "node": ">=20" },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:48673 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "lucide-react": "0.468.0",
    "vite": "6.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "electron": "34.5.8",
    "electron-builder": "25.1.8",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "com.shiguang.toolbox",
    "productName": "拾光工具箱",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "${productName}-安装版-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "拾光工具箱"
    },
    "portable": {
      "artifactName": "${productName}-便携版-${version}-${arch}.${ext}"
    }
  }
}
